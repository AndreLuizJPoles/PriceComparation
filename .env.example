# =============================================================================
# Price Comparator — environment template (demo-ready)
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# App
APP_NAME=Price Comparator
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DEMO_MODE=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
POSTGRES_USER=pricecomp
POSTGRES_PASSWORD=pricecomp_dev_change_me
POSTGRES_DB=pricecomp
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pricecomp:pricecomp_dev_change_me@db:5432/pricecomp

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
PRICE_REFRESH_INTERVAL_MINUTES=60

# Auth (placeholders for later phases — change before any real deploy)
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=refresh_token
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SEARCH_CACHE_TTL_SECONDS=300
ENABLED_STORE_ADAPTERS=demo

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true

# Optional integrations (leave empty until configured)
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
